# Local runtime files (shared Phoenix configuration is tracked below)
.nl2repo-local/*
.env
.env.*
*.env
!*.env.example
!.env.example

# Shared Phoenix configuration for running a fresh clone
!.nl2repo-local/gateway.env
!.nl2repo-local/litellm.phoenix.yaml
!.nl2repo-local/litellm.phoenix-azure.yaml

# Python environments and generated caches
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Evaluation outputs
logs/
result/
workspaces/
experiments/

# Editor and OS files
.DS_Store
*.swp
*.swo
