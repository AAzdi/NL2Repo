# 日常配置入口：将需要的条目合并到 .nl2repo-local/gateway.env。
# eval.sh 自动 source 该文件；已有文件不要直接覆盖。
# 下方使用 ${变量-默认值}，让调用命令前设置的环境变量优先。
# 取消所需条目的注释并替换占位值；未设置的条目继续使用模板/代码默认值。

# 选择路由：legacy（H100）、aws（B200）、azure（云 API）。
# export PHOENIX_ROUTING="${PHOENIX_ROUTING-aws}"

# AWS / B200
# x-eval-domain-proxy：多云网关域名，不是 SGLang 后端地址。
# export PHOENIX_MULTICLOUD_PROXY="${PHOENIX_MULTICLOUD_PROXY-accio-agentic-rl-multicloud-gateway-aws.vipserver:80}"
# X-Backend-Host：必须为 host:port，不带协议或路径。
# export SGLANG_IP_PORT="${SGLANG_IP_PORT-<B200 SGLang IP:端口>}"
# export PHOENIX_BACKEND_REGION="${PHOENIX_BACKEND_REGION-us_aws}"
# 同时设置 X-SMG-Routing-Key 和 X-Backend-TrajectoryID。
# export SANDBOX_TRAJECTORY_ID="${SANDBOX_TRAJECTORY_ID-<平台提供的轨迹 ID>}"

# legacy / H100
# export PHOENIX_DOMAIN_PROXY="${PHOENIX_DOMAIN_PROXY-http://<H100 SGLang IP:端口>}"

# aws 必须设置令牌；legacy 未设置时继承私有模板中的令牌。
# export PHOENIX_EVAL_TOKEN="${PHOENIX_EVAL_TOKEN-<eval token>}"

# Azure 云 API：tenant、empId、iai-tag 和默认模型保存在独立私有模板
# .nl2repo-local/litellm.phoenix-azure.yaml 中。
# export PHOENIX_AZURE_DOMAIN_PROXY="${PHOENIX_AZURE_DOMAIN_PROXY-https://iai.alibaba-inc.com}"
# export PHOENIX_AZURE_EVAL_TOKEN="${PHOENIX_AZURE_EVAL_TOKEN-<cloud eval token>}"

# 可选 Python 解释器；默认 .nl2repo-local/venv/bin/python。
# export NL2REPO_PYTHON="${NL2REPO_PYTHON-/absolute/path/to/python}"
